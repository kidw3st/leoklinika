map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
upstream websocket {
    server php:8080;
}
server {
    charset utf-8;
    client_max_body_size 128M;

    listen 80;
    listen 443 ssl;

    server_name ${HOST_NAME} www.${HOST_NAME};
    root        /var/www/web;
    index       index.php;

    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    location / {
        # Redirect everything that isn't a real file to index.php
        try_files $uri $uri/ /index.php$is_args$args;
    }

    ssl_certificate /etc/letsencrypt/live/${HOST_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${HOST_NAME}/privkey.pem;

    if ($server_port = 80) { set $https_redirect 1; }
    if ($host ~ '^www\.') { set $https_redirect 1; }
    if ($https_redirect = 1) { return 301 https://${HOST_NAME}$request_uri; }

    location /.well-known/acme-challenge/ { root /var/www/docker/certbot/www; break; }

    location ~ ^/(admin|assets|up|yii-assets|api|elfinder|gii|debug|robots.txt|sitemap.xml) {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass ${BACK_PROXY_URL};
        #fastcgi_pass unix:/var/run/php5-fpm.sock;
        try_files $uri =404;

        break;
    }
}
