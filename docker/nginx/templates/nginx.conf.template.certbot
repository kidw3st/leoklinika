server {
    charset utf-8;

    listen 80;

    server_name ${HOST_NAME} www.${HOST_NAME};
    root        /var/www/web;
    index       index.php;

    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    location /.well-known/acme-challenge/ { root /var/www/docker/certbot/www; }
}